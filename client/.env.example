# ── Client Environment ─────────────────────────────────────────────────────────
# Mode: "development" or "production"
VITE_APP_MODE=development

# API URL — leave empty in dev (Vite proxy handles /api/* → localhost:3000)
# Set to full URL in production, e.g. https://smartgarden-api.onrender.com
VITE_API_URL=
